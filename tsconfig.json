{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,

    // sequelize-typescript usa decoradores "legacy".
    // Regla del proyecto: SIEMPRE declarar el DataType en @Column(...),
    // porque tsx (esbuild) no emite la metadata de tipos en desarrollo.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Con ES2022 los campos de clase se definirían como propiedades propias y
    // taparían los getters de Sequelize (los atributos saldrían undefined).
    "useDefineForClassFields": false
  },
  "include": ["src"]
}
