# =====================================================================
#  Copia este archivo como .env y completa DATABASE_URL.
#  Todo lo demás tiene valores por defecto razonables.
# =====================================================================

# --- Servidor ---------------------------------------------------------
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS ("*" o lista separada por comas)
CORS_ORIGIN=*

# --- Base de datos (Neon: PostgreSQL + TimescaleDB) -------------------
# Panel de Neon > Connect > copia la cadena de conexión (preferible la "pooled").
# Ej: postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_SSL=true
DB_POOL_MAX=5
# true = imprime en consola el SQL que ejecuta Sequelize
DB_LOGGING=false

# --- Dominio ----------------------------------------------------------
# Zona horaria para "hoy" (máx/mín del día) y para formatear horas en el LCD
APP_TIMEZONE=America/Bogota
# Frecuencia de envío del ESP32 (el taller exige 20 s)
LECTURA_INTERVALO_SEG=20
# Segundos sin lecturas ni latidos para considerar un dispositivo OFFLINE
DISPOSITIVO_OFFLINE_SEG=90
